{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a"
      },
      "environment": "preview",
      "developmentClient": false
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "preview-android": {
      "extends": "preview",
      "credentialsSource": "local",
      "env": {
        "FOCALPOINT_EAS_OWNER": "wealthdigitals",
        "FOCALPOINT_EAS_PROJECT_ID": "6428833a-bccf-43b0-b02d-5ddc9225336a",
        "EXPO_PUBLIC_DESIGN_PREVIEW": "0"
      }
    },
    "production-android": {
      "extends": "production",
      "environment": "production",
      "credentialsSource": "local",
      "autoIncrement": false,
      "env": {
        "FOCALPOINT_EAS_OWNER": "wealthdigitals",
        "FOCALPOINT_EAS_PROJECT_ID": "6428833a-bccf-43b0-b02d-5ddc9225336a",
        "EXPO_PUBLIC_DESIGN_PREVIEW": "0"
      }
    }
  }
}
